#!/bin/bash

# -----------------------------------------------------------------------------
# Google Cloud Project Configuration
#
# Copy this file to gcp_config.sh and fill in your project-specific values.
# The gcp_config.sh file is ignored by git so you can safely store secrets.
# -----------------------------------------------------------------------------

# --- Project Details ---
# Your Google Cloud Project ID
PROJECT_ID="google project"

# The service name for Cloud Run
SERVICE_NAME="service name"

# The region to deploy the service in
REGION="google region"

# --- APNS Configuration ---
# The path to your local APNS .p8 key file
LOCAL_APNS_KEY_PATH="path to apns key file"
APNS_KEY_ID="apns key"
APNS_ENV="production"
APNS_TEAM_ID="snv234"
APNS_BUNDLE_ID="com.fredflinstone.myapp"

# --- Reconciler ---
# Set this value to a time to start reconciliation process at that interval
# Set value to 0 or comment out to prevent reconciliation process from running
# RECONCILE_INTERVAL=10m

# --- Theme Park API Key ---
# Your API key for the Theme Park Wiki
# Replace with your actual key.
THEMEPARK_API_KEY="your-themepark-api-key"

# The WebSocket URL for the live entity feed.
WEBSOCKET_URL="wss://api.themeparks.wiki/v1/live" 

# --- Supabase Configuration ---
# Your Supabase database connection string (contains password - will be stored as a secret)
# Get this from your Supabase dashboard: Settings → Database → Connection pooling
SUPABASE_DB_URL="postgresql://postgres.ghyskcyicrqkfcpblzcw:your-database-password@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# --- Static Asset Bucket ---
# GCS bucket for static JSON assets (manifest.json, etc.). Must be globally unique across all of GCS.
STATIC_BUCKET_NAME="your-static-bucket-name"